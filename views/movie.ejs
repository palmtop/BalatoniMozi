<!DOCTYPE html>
<html lang="hu">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= movieName %>
  </title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 1rem;
      background: #eef2f5;
    }

    h1 {
      text-align: center;
      margin-bottom: 1rem;
    }

    .card {
      background: white;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      padding: 1rem;
      margin-bottom: 1rem;
    }

    .card h2 {
      font-size: 1.2rem;
      margin-top: 0;
      color: #0077aa;
    }

    .card ul {
      list-style: none;
      padding-left: 0;
    }

    .card li {
      padding: 0.2rem 0;
    }
  </style>
</head>

<body>
  <p><a href="/"><i class="fas fa-home"></i></a></p>
  <h1>
    <%= movieName %>
  </h1>

  <div class="card">
    <h2>Dates and Theaters</h2>
    <ul>
      <% schedule.forEach(movie=> { %>
        <li><strong>
            <%= movie.date %>:
          </strong>
          <%= movie.theater %>
        </li>
        <% }); %>
    </ul>
  </div>
  <div class="card" style="display: flex; align-items: flex-start;">
    <img src="<%= 'https://image.tmdb.org/t/p/w342'+MovieDetails.poster_file %>" alt="Movie poster"
      style="width: 342px; border-radius: 8px; margin-right: 1rem;">
    <div>
      <h2>Film részletek</h2>
      <ul>
        <li><strong>Név:</strong>
          <%= MovieDetails.tmdb_name %>
        </li>
        <li><strong>Műfaj:</strong>
          <%= MovieDetails.genre %>
        </li>
        <li><strong>Korhatár:</strong>
          <%= MovieDetails.rating %>
        </li>
        <li><strong>Megjelenés éve:</strong>
          <%= MovieDetails.year %>
        </li>
        <li><strong>Leírás:</strong>
          <%= MovieDetails.summary %>
        </li>
      </ul>
    </div>
  </div>
</body>

</html>